<Window x:Class="ArcRecorder.RecIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REC" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight" IsHitTestVisible="False" Focusable="False">
    <!-- Индикатор записи как у NVIDIA: маленькая красная точка в правом нижнем углу, без текста и таймера.
         Тёмная подложка — чтобы точку было видно и на светлом фоне. -->
    <Grid Margin="4">
        <Ellipse Width="20" Height="20" Fill="#B3141416" Stroke="#40FFFFFF" StrokeThickness="1"/>
        <Ellipse Width="10" Height="10" Fill="#E53935"/>
    </Grid>
</Window>
