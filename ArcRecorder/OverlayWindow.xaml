<Window x:Class="ArcRecorder.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArcRecorder Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="420" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Кнопка-иконка в шапке -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка меню: line-иконка + название + подпись-хоткей -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкая line-иконка строки -->
        <Style x:Key="RowIconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource IconBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowChevron" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
            <Setter Property="Margin" Value="20,6"/>
        </Style>
    </Window.Resources>

    <!-- Боковая панель во всю высоту, прижата к левому краю -->
    <Border x:Name="RootPanel" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
            <!-- Шапка: intel. | Arc Recorder -->
            <DockPanel DockPanel.Dock="Top" Margin="20,18,12,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource IconButton}" Click="SettingsButton_Click"/>
                    <Button Content="✕" Style="{StaticResource IconButton}" Click="CloseButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="22" Foreground="{StaticResource TextBrush}">
                        <Run Text="intel"/><Run Text="." FontWeight="Bold"/>
                    </TextBlock>
                    <Border Width="1" Height="24" Background="{StaticResource LineBrush}" Margin="10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Arc Recorder" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="GpuSubText" Text="QSV" FontSize="10.5" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Фирменная intel-линия под шапкой -->
            <Border DockPanel.Dock="Top" Height="2" Margin="20,12,20,14" Background="{StaticResource BrandLineBrush}"/>

            <!-- Хоткеи снизу -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="HotkeysText" Margin="20,10,20,14" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="#6A6C75"
                           Text="Alt+Z оверлей · Alt+F9 запись · Alt+F10 повтор · Alt+F1 снимок · Alt+F2 фоторежим · Alt+R FPS"/>
            </Border>

            <Grid>
                <!-- ======== ГЛАВНОЕ МЕНЮ (как у NVIDIA) ======== -->
                <ScrollViewer x:Name="MenuPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Статус записи -->
                        <Border Background="{StaticResource InsetBrush}" CornerRadius="4" Padding="14,12" Margin="20,0,20,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="StatusText" Text="Готов" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TimerText" Text="" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Foreground="{StaticResource RecBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ReplayStatusText" Text="Повтор: выкл" FontSize="11" Margin="17,4,0,0"
                                           Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Галерея -->
                        <Button Style="{StaticResource MenuRow}" Click="GalleryRow_Click">
                            <DockPanel>
                                <Path Data="{StaticResource IconGallery}" Style="{StaticResource RowIconPath}"/>
                                <TextBlock Text="›" Style="{StaticResource RowChevron}" DockPanel.Dock="Right"/>
                                <StackPanel>
                                    <TextBlock x:Name="GalleryTitle" Text="Галерея" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="GallerySubText" Text="Открыть папку записей" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Border Style="{StaticResource Separator}"/>

                        <!-- Запись -->
                        <Button x:Name="RecordRow" Style="{StaticResource MenuRow}" Click="RecordRow_Click">
                            <DockPanel>
                                <Grid VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Path Data="{StaticResource IconRecord}" Style="{StaticResource RowIconPath}" Margin="0"/>
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RecBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="RecordChevron" Text="▶" Style="{StaticResource RowChevron}" DockPanel.Dock="Right"/>
                                <StackPanel>
                                    <TextBlock x:Name="RecordRowTitle" Text="Запись" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="RecordSubText" Text="Alt+F9 — запуск / стоп" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Мгновенный повтор -->
                        <Button x:Name="ReplayRow" Style="{StaticResource MenuRow}" Click="ReplayRow_Click">
                            <DockPanel>
                                <Path Data="{StaticResource IconReplay}" Style="{StaticResource RowIconPath}"/>
                                <TextBlock Text="›" Style="{StaticResource RowChevron}" DockPanel.Dock="Right"/>
                                <StackPanel>
                                    <TextBlock x:Name="ReplayTitle" Text="Мгновенный повтор" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="ReplayRowSub" Text="Alt+F10 — сохранить последние минуты" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Снимок экрана -->
                        <Button Style="{StaticResource MenuRow}" Click="ScreenshotRow_Click">
                            <DockPanel>
                                <Path Data="{StaticResource IconScreenshot}" Style="{StaticResource RowIconPath}"/>
                                <TextBlock Text="›" Style="{StaticResource RowChevron}" DockPanel.Dock="Right"/>
                                <StackPanel>
                                    <TextBlock x:Name="ScreenshotTitle" Text="Снимок экрана" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="ScreenshotSubText" Text="Alt+F1 — сохранить снимок экрана" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Фоторежим -->
                        <Button Style="{StaticResource MenuRow}" Click="PhotoModeRow_Click">
                            <DockPanel>
                                <Path Data="{StaticResource IconPhoto}" Style="{StaticResource RowIconPath}"/>
                                <TextBlock Text="›" Style="{StaticResource RowChevron}" DockPanel.Dock="Right"/>
                                <StackPanel>
                                    <TextBlock x:Name="PhotoTitle" Text="Фоторежим" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="PhotoSubText" Text="Alt+F2 — снимок активного окна" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Border Style="{StaticResource Separator}"/>

                        <!-- FPS-счётчик -->
                        <Button Style="{StaticResource MenuRow}" Click="FpsRow_Click">
                            <DockPanel>
                                <Path Data="{StaticResource IconFps}" Style="{StaticResource RowIconPath}"/>
                                <TextBlock x:Name="FpsRowState" Text="выкл" Style="{StaticResource RowChevron}" DockPanel.Dock="Right"/>
                                <StackPanel>
                                    <TextBlock x:Name="FpsRowTitle" Text="Счётчик FPS" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="FpsSubText" Text="Alt+R — включение/выключение" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Border Style="{StaticResource Separator}"/>

                        <!-- Микрофон -->
                        <Button Style="{StaticResource MenuRow}" Click="MicRow_Click">
                            <DockPanel>
                                <Path Data="{StaticResource IconMic}" Style="{StaticResource RowIconPath}"/>
                                <TextBlock x:Name="MicRowState" Text="выкл" Style="{StaticResource RowChevron}" DockPanel.Dock="Right"/>
                                <StackPanel>
                                    <TextBlock x:Name="MicTitle" Text="Микрофон" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="MicRowSub" Text="Писать микрофон в запись" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======== НАСТРОЙКИ (по шестерёнке) ======== -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20,4">
                        <Button x:Name="BackButton" Style="{StaticResource OverlayButton}" HorizontalContentAlignment="Left"
                                Margin="0,0,0,12" Padding="12,8" Click="BackButton_Click" Content="‹  Назад"/>

                        <TextBlock x:Name="InterfaceHeader" Text="ИНТЕРФЕЙС" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LanguageLabel" Text="Язык / Language" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed" Margin="0,0,0,12">
                            <ComboBoxItem Content="Русский" Tag="ru"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>

                        <TextBlock x:Name="CaptureHeader" Text="ЗАХВАТ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="WhatToRecordLabel" Text="Что записывать" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CaptureModeBox" SelectionChanged="Setting_Changed" Margin="0,0,0,2">
                            <ComboBoxItem x:Name="CapScreenItem" Content="Весь монитор" Tag="Screen"/>
                            <ComboBoxItem x:Name="CapWindowItem" Content="Окно (активное при старте записи)" Tag="Window"/>
                        </ComboBox>
                        <TextBlock x:Name="WindowHintText" Text="В режиме окна пишется только выбранное приложение — Alt+Tab в запись не попадает"
                                   FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="CodecLabel" Text="Кодек" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CodecBox" SelectionChanged="Setting_Changed" Margin="0,0,0,8">
                            <ComboBoxItem x:Name="CodecAv1Item" Content="AV1 — топ качество/размер (Arc)" Tag="AV1"/>
                            <ComboBoxItem Content="HEVC (H.265)" Tag="HEVC"/>
                            <ComboBoxItem x:Name="CodecH264Item" Content="H.264 (AVC) — совместимость" Tag="H264"/>
                        </ComboBox>

                        <TextBlock Text="FPS" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="FpsBox" SelectionChanged="Setting_Changed" Margin="0,0,0,8">
                            <ComboBoxItem Content="30 FPS" Tag="30"/>
                            <ComboBoxItem Content="60 FPS" Tag="60"/>
                            <ComboBoxItem Content="120 FPS" Tag="120"/>
                        </ComboBox>

                        <TextBlock x:Name="ResolutionLabel" Text="Разрешение" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ResolutionBox" SelectionChanged="Setting_Changed" Margin="0,0,0,8">
                            <ComboBoxItem x:Name="ResNativeItem" Content="Нативное (как на мониторе)" Tag="0"/>
                            <ComboBoxItem Content="2160p (4K)" Tag="2160"/>
                            <ComboBoxItem Content="1440p" Tag="1440"/>
                            <ComboBoxItem Content="1080p" Tag="1080"/>
                            <ComboBoxItem Content="720p" Tag="720"/>
                        </ComboBox>

                        <TextBlock x:Name="BitrateTitle" Text="Битрейт" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="BitrateLabel" Text="35 Мбит/с" DockPanel.Dock="Right" Width="72"
                                       Foreground="{StaticResource TextBrush}" TextAlignment="Right"/>
                            <Slider x:Name="BitrateSlider" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="BitrateSlider_ValueChanged"/>
                        </DockPanel>

                        <TextBlock x:Name="MonitorLabel" Text="Монитор" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="MonitorBox" SelectionChanged="Setting_Changed" Margin="0,0,0,12"/>

                        <TextBlock x:Name="AudioHeader" Text="ЗВУК" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="SystemAudioCheck" Content="Системный звук" Foreground="{StaticResource TextBrush}"
                                  Margin="0,2,0,4" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="MicCheck" Content="Микрофон" Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,12" Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                        <TextBlock x:Name="ReplayHeader" Text="МГНОВЕННЫЙ ПОВТОР" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ReplayCheck" Content="Держать буфер повтора включённым" Foreground="{StaticResource TextBrush}"
                                  Margin="0,2,0,6" Checked="ReplayCheck_Changed" Unchecked="ReplayCheck_Changed"/>
                        <TextBlock x:Name="BufferLenLabel" Text="Длина буфера" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ReplayLenBox" SelectionChanged="Setting_Changed" Margin="0,0,0,12">
                            <ComboBoxItem x:Name="Min1Item" Content="1 минута" Tag="1"/>
                            <ComboBoxItem x:Name="Min3Item" Content="3 минуты" Tag="3"/>
                            <ComboBoxItem x:Name="Min5Item" Content="5 минут" Tag="5"/>
                            <ComboBoxItem x:Name="Min10Item" Content="10 минут" Tag="10"/>
                        </ComboBox>

                        <TextBlock x:Name="OverlaysHeader" Text="ОВЕРЛЕИ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="FpsOverlayCheck" Content="Счётчик FPS (Alt+R)" Foreground="{StaticResource TextBrush}"
                                  Margin="0,2,0,8" Checked="FpsOverlayCheck_Changed" Unchecked="FpsOverlayCheck_Changed"/>

                        <TextBlock x:Name="FpsPosLabel" Text="Позиция счётчика" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="FpsCornerBox" SelectionChanged="FpsSetting_Changed" Margin="0,0,0,8">
                            <ComboBoxItem x:Name="CornerTL" Content="Слева сверху" Tag="0"/>
                            <ComboBoxItem x:Name="CornerTR" Content="Справа сверху" Tag="1"/>
                            <ComboBoxItem x:Name="CornerBL" Content="Слева снизу" Tag="2"/>
                            <ComboBoxItem x:Name="CornerBR" Content="Справа снизу" Tag="3"/>
                        </ComboBox>

                        <TextBlock x:Name="FpsSizeLabel" Text="Размер счётчика" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="FpsScaleBox" SelectionChanged="FpsSetting_Changed" Margin="0,0,0,8">
                            <ComboBoxItem x:Name="SizeSItem" Content="Маленький (75%)" Tag="75"/>
                            <ComboBoxItem x:Name="SizeMItem" Content="Обычный (100%)" Tag="100"/>
                            <ComboBoxItem x:Name="SizeLItem" Content="Большой (125%)" Tag="125"/>
                            <ComboBoxItem x:Name="SizeXLItem" Content="Огромный (150%)" Tag="150"/>
                        </ComboBox>

                        <CheckBox x:Name="FpsAutoThemeCheck" Content="Автоцвет: тёмный текст на светлом фоне" Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,4" Checked="FpsSetting_Changed" Unchecked="FpsSetting_Changed"/>
                        <CheckBox x:Name="FpsHideDesktopCheck" Content="Прятать на рабочем столе (только в играх)" Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,8" Checked="FpsSetting_Changed" Unchecked="FpsSetting_Changed"/>
                        <CheckBox x:Name="NotificationsCheck" Content="Уведомления о записи, повторе и снимках" Foreground="{StaticResource TextBrush}"
                                  Margin="0,4,0,8" Checked="NotificationsCheck_Changed" Unchecked="NotificationsCheck_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>

